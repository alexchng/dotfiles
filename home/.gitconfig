[core]
	editor = vim
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[alias]
	st = status -sb
	co = checkout
	sw = switch
	ci = commit
	br = branch
	lg = log --oneline --decorate --graph --all

[include]
	path = ~/.config/git/tech.gitconfig
